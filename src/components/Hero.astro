<script>
	function armIntro() {
		const name = document.querySelector<HTMLElement>('.hero-name');
		const rule = document.querySelector<HTMLElement>('.hero-rule');
		const links = document.querySelector<HTMLElement>('.hero-links');
		if (name) name.style.animation = 'none';
		if (rule)  { rule.style.animation  = 'none'; rule.style.width = '0'; }
		if (links) { links.style.animation = 'none'; links.style.opacity = '0'; }
		void document.body.offsetHeight;
		if (name) name.style.animation = '';
		if (rule)  rule.style.animation  = '';
		if (links) links.style.animation = '';
	}

	window.addEventListener('pageshow', (e) => {
		if (e.persisted) armIntro();
	});
</script>

