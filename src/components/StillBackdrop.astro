---
// Calm backdrop for reading pages: a heavily blurred, darkened frame of the
// homepage video. Shares a view-transition name with VideoWarp so navigating
// between them crossfades the live video into the still.
interface Props {
	src: string;
}
const { src } = Astro.props;
---

<div class="still" aria-hidden="true" style={`--still: url('${src}')`}></div>

<style>
	.still {
		position: fixed;
		inset: 0;
		z-index: -2;
		pointer-events: none;
		view-transition-name: backdrop;
		background:
			radial-gradient(ellipse at center, transparent 35%, rgba(8, 10, 22, 0.55) 100%),
			linear-gradient(180deg, rgba(20, 24, 48, 0.55), rgba(20, 24, 48, 0.82)),
			var(--still) center / cover no-repeat,
			var(--ink);
	}
	@media print {
		.still { display: none; }
	}
</style>
