---
// Full-screen background video, warped in real time by a WebGL shader:
// low-frequency noise slowly drags the picture around like liquid, with a
// finer ripple layered on top.
//
// - Portrait screens (phones) get their own 9:16 cut, so they show real
//   detail instead of an upscaled sliver of the landscape video.
// - Without WebGL the plain video plays with the same crop and darkening.
// - Reduced motion or data saver: a still poster, the video never loads.
interface Props {
	src: string;
	poster?: string;
	portraitSrc?: string; // 9:16 cut for portrait screens
	portraitPoster?: string;
	zoom?: number; // >1 crops in so warped edges never show
	portraitZoom?: number; // the portrait cut needs much less crop
	amplitude?: number; // strength of the big slow warp
	size?: number; // scale of the big warp blobs (higher = smaller blobs)
	speed?: number; // how fast the warp drifts
	ripple?: number; // strength of the fine ripple
	tint?: number; // 0..1 darkening toward --ink for text legibility
	blur?: number; // soft-focus radius in CSS pixels (0 = sharp)
	vignette?: number; // 0..1 darkening toward the edges and corners
	controls?: boolean; // show the tuning panel (dev only)
}

const {
	src,
	poster,
	portraitSrc = src,
	portraitPoster = poster,
	zoom = 1.35,
	portraitZoom = 1.06,
	amplitude = 0.06,
	size = 1.6,
	speed = 0.06,
	ripple = 0.004,
	tint = 0.45,
	blur = 26.5,
	vignette = 0.6,
	controls = false,
} = Astro.props;
---

<div
	class="vwarp"
	aria-hidden="true"
	style={`--zoom: ${zoom}; --zoom-portrait: ${portraitZoom}; --tint: ${tint}; --blur: ${blur}; --vignette: ${vignette}`}
	data-src={src}
	data-poster={poster}
	data-src-portrait={portraitSrc}
	data-poster-portrait={portraitPoster}
	data-zoom={zoom}
	data-portrait-zoom={portraitZoom}
	data-amplitude={amplitude}
	data-size={size}
	data-speed={speed}
	data-ripple={ripple}
	data-tint={tint}
	data-blur={blur}
	data-vignette={vignette}
>
	<!-- src is set from JS so phones never download the landscape file. -->
	<video class="vwarp-video" poster={poster} muted loop playsinline preload="none"></video>
	<canvas class="vwarp-canvas"></canvas>
</div>

{controls && (
	<div class="vwarp-panel">
		<button type="button" class="vwarp-toggle" aria-expanded="true" aria-controls="vwarp-body">warp</button>
		<form class="vwarp-body" id="vwarp-body" aria-label="Warp controls">
			<label><span>zoom</span> <input type="range" name="zoom" min="1" max="2" step="0.01" value={zoom} /></label>
			<label><span>amplitude</span> <input type="range" name="amplitude" min="0" max="0.25" step="0.005" value={amplitude} /></label>
			<label><span>size</span> <input type="range" name="size" min="0.3" max="6" step="0.1" value={size} /></label>
			<label><span>speed</span> <input type="range" name="speed" min="0" max="0.4" step="0.005" value={speed} /></label>
			<label><span>ripple</span> <input type="range" name="ripple" min="0" max="0.03" step="0.0005" value={ripple} /></label>
			<label><span>vignette</span> <input type="range" name="vignette" min="0" max="1" step="0.01" value={vignette} /></label>
			<label><span>tint</span> <input type="range" name="tint" min="0" max="1" step="0.01" value={tint} /></label>
			<output></output>
		</form>
	</div>
)}

<style>
	.vwarp {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		/* Size to the *large* viewport so the canvas doesn't resize every time
		   a mobile browser's address bar slides in or out. */
		height: 100vh;
		height: 100lvh;
		z-index: -2;
		pointer-events: none;
		overflow: hidden;
		background: var(--ink, #000);
		view-transition-name: backdrop;
	}
	.vwarp-video,
	.vwarp-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* Fallback (no WebGL / reduced motion): same crop and darkening as the
	   shader, just without the warp. */
	.vwarp-video {
		transform: scale(var(--zoom, 1.35));
		filter: blur(calc(var(--blur, 0) * 1px));
		/* Overshoot the screen by 2x the blur radius so the blur never pulls
		   in dark edges. */
		top: calc(var(--blur, 0) * -2px);
		left: calc(var(--blur, 0) * -2px);
		width: calc(100% + var(--blur, 0) * 4px);
		height: calc(100% + var(--blur, 0) * 4px);
	}
	@media (max-aspect-ratio: 1/1) {
		.vwarp-video {
			transform: scale(var(--zoom-portrait, 1.06));
		}
	}
	.vwarp::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--ink, #000);
		opacity: var(--tint, 0.45);
	}
	.vwarp::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		background: radial-gradient(ellipse at center, transparent 35%, rgba(8, 10, 22, 0.95) 100%);
		opacity: var(--vignette, 0.6);
	}
	.vwarp.gl::after,
	.vwarp.gl::before {
		display: none;
	}
	/* The video is only a texture source once WebGL is running. */
	.vwarp.gl .vwarp-video {
		visibility: hidden;
	}
	.vwarp:not(.gl) .vwarp-canvas {
		display: none;
	}

	/* ---- Tuning panel (dev only) ---- */
	.vwarp-panel {
		position: fixed;
		right: 16px;
		bottom: calc(16px + env(safe-area-inset-bottom, 0px));
		z-index: 200;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 8px;
		font: 12px/1.2 ui-monospace, monospace;
		color: #fff;
	}
	.vwarp-toggle {
		font: inherit;
		font-weight: 700;
		color: #fff;
		background: rgba(0, 0, 0, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		padding: 8px 14px;
		min-height: 36px;
		cursor: pointer;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}
	.vwarp-toggle::after {
		content: ' ▾';
	}
	.vwarp-toggle[aria-expanded='false']::after {
		content: ' ▴';
	}
	.vwarp-body {
		order: -1; /* sits above the toggle */
		display: grid;
		gap: 6px;
		padding: 12px 14px;
		background: rgba(0, 0, 0, 0.6);
		border-radius: 10px;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}
	.vwarp-toggle[aria-expanded='false'] + .vwarp-body {
		display: none;
	}
	.vwarp-body label {
		display: grid;
		grid-template-columns: 80px 160px;
		align-items: center;
	}
	.vwarp-body input[type='range'] {
		width: 100%;
		margin: 0;
		accent-color: var(--accent, #e8b66c);
	}
	.vwarp-body output {
		white-space: pre;
		opacity: 0.7;
		user-select: all;
		-webkit-user-select: all;
	}

	/* Phones: a full-width bottom sheet with finger-sized sliders that
	   scrolls rather than covering the whole screen. */
	@media (max-width: 600px) {
		.vwarp-panel {
			left: 8px;
			right: 8px;
			bottom: calc(8px + env(safe-area-inset-bottom, 0px));
		}
		.vwarp-body {
			width: 100%;
			box-sizing: border-box;
			max-height: 50svh;
			overflow-y: auto;
			font-size: 13px;
		}
		.vwarp-body label {
			grid-template-columns: 84px 1fr;
		}
		.vwarp-body input[type='range'] {
			height: 36px;
		}
		.vwarp-body output {
			font-size: 11px;
		}
	}
</style>

<script>
	const VERT = `
attribute vec2 p;
varying vec2 vUv;
void main() {
	vUv = p * 0.5 + 0.5;
	gl_Position = vec4(p, 0.0, 1.0);
}`;

	const FRAG = `
precision highp float;
varying vec2 vUv;
uniform sampler2D uTex;
uniform float uTime, uZoom, uAmp, uSize, uSpeed, uRipple, uTint, uVignette;
uniform vec2 uCover;   // scale that makes the video "object-fit: cover"
uniform vec2 uBlur;    // blur radius in texture UV units (0 = off)
uniform vec3 uInk;

// Smooth value noise + fbm.
float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
	vec2 i = floor(p), f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x),
	           mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
}
float fbm(vec2 p) {
	float v = 0.0, a = 0.5;
	for (int i = 0; i < 4; i++) { v += a * noise(p); p = p * 2.03 + 11.7; a *= 0.5; }
	return v;
}

// Soft focus: 16 taps on a spiral disk, rotated per pixel so large radii
// turn into fine noise (hidden by the grain) instead of visible rings.
vec3 sampleBlurred(vec2 uv) {
	if (uBlur.x <= 0.0) return texture2D(uTex, clamp(uv, 0.001, 0.999)).rgb;
	float rot = hash(gl_FragCoord.xy) * 6.2831;
	vec3 acc = vec3(0.0);
	for (int i = 0; i < 16; i++) {
		float fi = float(i);
		float r = sqrt((fi + 0.5) / 16.0);
		float a = fi * 2.39996 + rot;
		acc += texture2D(uTex, clamp(uv + vec2(cos(a), sin(a)) * r * uBlur, 0.001, 0.999)).rgb;
	}
	return acc / 16.0;
}

void main() {
	vec2 uv = (vUv - 0.5) * uCover / uZoom + 0.5;
	float t = uTime * uSpeed;

	// Big slow warp: domain-warped fbm gives flowing, melting distortion.
	vec2 q = uv * uSize;
	vec2 w = vec2(fbm(q + vec2(0.0, t)), fbm(q + vec2(5.2, -t * 0.8)));
	vec2 off = vec2(fbm(q + 2.0 * w + vec2(1.7, 9.2) + t),
	                fbm(q + 2.0 * w + vec2(8.3, 2.8) - t)) - 0.5;
	uv += off * uAmp;

	// Fine ripple on top.
	uv += uRipple * vec2(sin(uv.y * 40.0 + uTime * 1.3), cos(uv.x * 34.0 - uTime * 1.1));

	vec3 col = sampleBlurred(uv);
	col = mix(col, uInk, uTint);

	// Vignette: darken toward the edges, strongest in the corners.
	float edge = smoothstep(0.35, 1.0, length(vUv - 0.5) * 1.4142);
	col = mix(col, uInk * 0.45, edge * uVignette);
	gl_FragColor = vec4(col, 1.0);
}`;

	function hexToRgb(hex: string): [number, number, number] {
		const m = hex.trim().replace('#', '');
		const n = parseInt(m.length === 3 ? m.replace(/./g, (c) => c + c) : m, 16);
		return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
	}

	function init(root: HTMLElement) {
		const video = root.querySelector('video')!;
		const canvas = root.querySelector('canvas')!;
		const d = root.dataset;
		const portraitMq = matchMedia('(max-aspect-ratio: 1/1)');
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const saveData = (navigator as any).connection?.saveData === true;

		const params = {
			zoom: +d.zoom!,
			portraitZoom: +d.portraitZoom!,
			amplitude: +d.amplitude!,
			size: +d.size!,
			speed: +d.speed!,
			ripple: +d.ripple!,
			tint: +d.tint!,
			blur: +d.blur!,
			vignette: +d.vignette!,
		};
		const isPortrait = () => portraitMq.matches;
		const activeZoom = () => (isPortrait() ? params.portraitZoom : params.zoom);

		// Pick the cut that matches the screen's shape.
		const applySource = () => {
			const portrait = isPortrait();
			const poster = (portrait ? d.posterPortrait : d.poster) || '';
			if (poster && video.getAttribute('poster') !== poster) video.poster = poster;
			if (reduced || saveData) return; // still poster only
			const src = (portrait ? d.srcPortrait : d.src) || '';
			if (video.getAttribute('src') !== src) {
				const t = video.currentTime;
				video.src = src;
				video.currentTime = t;
				play();
			}
		};

		// Autoplay can be refused (e.g. iOS Low Power Mode): retry on first touch.
		const play = () => {
			video.play().catch(() => {
				const retry = () => { video.play().catch(() => {}); };
				document.addEventListener('pointerdown', retry, { once: true });
				document.addEventListener('touchend', retry, { once: true });
			});
		};

		applySource();
		portraitMq.addEventListener('change', applySource);
		if (reduced || saveData) return;

		setupPanel(params, activeZoom, isPortrait, portraitMq);

		const gl = canvas.getContext('webgl', { antialias: false, premultipliedAlpha: false });
		if (!gl) return; // plain <video> stays visible

		const compile = (type: number, src: string) => {
			const s = gl.createShader(type)!;
			gl.shaderSource(s, src);
			gl.compileShader(s);
			if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) || 'shader');
			return s;
		};
		const prog = gl.createProgram()!;
		gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
		gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
		gl.linkProgram(prog);
		gl.useProgram(prog);

		// One oversized triangle covers the screen.
		gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const loc = gl.getAttribLocation(prog, 'p');
		gl.enableVertexAttribArray(loc);
		gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

		const tex = gl.createTexture();
		gl.bindTexture(gl.TEXTURE_2D, tex);
		gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
		// Video sizes are rarely powers of two: clamp + linear, no mipmaps.
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);

		const u = (n: string) => gl.getUniformLocation(prog, n);
		const U = {
			time: u('uTime'), zoom: u('uZoom'), amp: u('uAmp'), size: u('uSize'), speed: u('uSpeed'),
			ripple: u('uRipple'), tint: u('uTint'), cover: u('uCover'), ink: u('uInk'), blur: u('uBlur'), vignette: u('uVignette'),
		};
		const ink = getComputedStyle(document.documentElement).getPropertyValue('--ink') || '#141830';
		gl.uniform3fv(U.ink, hexToRgb(ink));

		let hasFrame = false;
		const upload = () => {
			if (video.readyState < 2) return;
			gl.bindTexture(gl.TEXTURE_2D, tex);
			gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, video);
			hasFrame = true;
		};
		// Upload only when the video actually has a new frame, where supported.
		const rvfc = 'requestVideoFrameCallback' in video;
		if (rvfc) {
			const onFrame = () => { upload(); (video as any).requestVideoFrameCallback(onFrame); };
			(video as any).requestVideoFrameCallback(onFrame);
		}

		// Size the drawing buffer to the element, and only reallocate when that
		// actually changes. Phones have 3x screens; 1.5x is plenty under a warp.
		const resize = () => {
			const dpr = Math.min(devicePixelRatio || 1, 1.5);
			const w = Math.round(canvas.clientWidth * dpr);
			const h = Math.round(canvas.clientHeight * dpr);
			if (w === canvas.width && h === canvas.height) return;
			canvas.width = w;
			canvas.height = h;
			gl.viewport(0, 0, w, h);
		};
		resize();
		new ResizeObserver(resize).observe(canvas);

		let raf = 0;
		const start = performance.now();
		const draw = (now: number) => {
			if (!rvfc) upload();
			if (hasFrame) {
				// object-fit: cover math
				const va = (video.videoWidth || 16) / (video.videoHeight || 9);
				const ca = canvas.width / canvas.height;
				const cover = ca > va ? [1, va / ca] : [ca / va, 1];
				gl.uniform2f(U.cover, cover[0], cover[1]);
				// Blur is set in CSS px; convert to texture UV units for this frame.
				const dpr = canvas.width / (canvas.clientWidth || canvas.width);
				const z = activeZoom();
				gl.uniform2f(U.blur,
					(params.blur * dpr / canvas.width) * cover[0] / z,
					(params.blur * dpr / canvas.height) * cover[1] / z);
				gl.uniform1f(U.time, (now - start) / 1000);
				gl.uniform1f(U.zoom, activeZoom());
				gl.uniform1f(U.amp, params.amplitude);
				gl.uniform1f(U.size, params.size);
				gl.uniform1f(U.speed, params.speed);
				gl.uniform1f(U.ripple, params.ripple);
				gl.uniform1f(U.tint, params.tint);
				gl.uniform1f(U.vignette, params.vignette);
				gl.drawArrays(gl.TRIANGLES, 0, 3);
				root.classList.add('gl');
			}
			raf = requestAnimationFrame(draw);
		};
		raf = requestAnimationFrame(draw);

		// Pause everything while the tab is hidden.
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) { cancelAnimationFrame(raf); video.pause(); }
			else { play(); raf = requestAnimationFrame(draw); }
		});
	}

	// Tuning panel (dev only). The zoom slider edits whichever zoom matches the
	// current screen shape, so landscape and portrait can be tuned separately.
	function setupPanel(
		params: Record<string, number>,
		activeZoom: () => number,
		isPortrait: () => boolean,
		portraitMq: MediaQueryList,
	) {
		const panel = document.querySelector<HTMLElement>('.vwarp-panel');
		if (!panel) return;
		const toggle = panel.querySelector<HTMLButtonElement>('.vwarp-toggle')!;
		const form = panel.querySelector('form')!;
		const out = form.querySelector('output')!;
		const zoomInput = form.querySelector<HTMLInputElement>('input[name="zoom"]')!;
		const zoomLabel = zoomInput.previousElementSibling as HTMLElement;

		// Collapsed by default on phones; remember the choice per browser.
		const KEY = 'vwarp-panel-open';
		let open = matchMedia('(min-width: 601px)').matches;
		try {
			const saved = localStorage.getItem(KEY);
			if (saved !== null) open = saved === '1';
		} catch {}
		const setOpen = (v: boolean) => {
			toggle.setAttribute('aria-expanded', String(v));
			try { localStorage.setItem(KEY, v ? '1' : '0'); } catch {}
		};
		setOpen(open);
		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

		const render = () => {
			out.textContent = Object.entries(params).filter(([k]) => k !== 'blur').map(([k, v]) => `${k}={${v}}`).join('\n');
		};
		const syncZoomSlider = () => {
			zoomInput.value = String(activeZoom());
			zoomLabel.textContent = isPortrait() ? 'zoom (portrait)' : 'zoom';
		};
		form.addEventListener('input', (e) => {
			const el = e.target as HTMLInputElement;
			if (el.name === 'zoom') params[isPortrait() ? 'portraitZoom' : 'zoom'] = +el.value;
			else params[el.name] = +el.value;
			if (el.name === 'vignette') document.querySelector<HTMLElement>('.vwarp')?.style.setProperty('--vignette', el.value);
			render();
		});
		portraitMq.addEventListener('change', syncZoomSlider);
		syncZoomSlider();
		render();
	}

	document.querySelectorAll<HTMLElement>('.vwarp').forEach(init);
</script>
