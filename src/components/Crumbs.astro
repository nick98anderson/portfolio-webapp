---
const { active } = Astro.props as { active: 'about' | 'resume' };
---

<nav class="crumbs" aria-label="Breadcrumb">
	<a href="/" aria-label="Home">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10"/></svg>
	</a>
	<span class="sep">/</span>
	<a href="/about" class:list={{ active: active === 'about' }} aria-label="About" aria-current={active === 'about' ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
	</a>
	<span class="sep">/</span>
	<a href="/resume" class:list={{ active: active === 'resume' }} aria-label="Resume" aria-current={active === 'resume' ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
	</a>
</nav>

<style>
	.crumbs {
		position: fixed;
		top: 1.25rem;
		left: 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		z-index: 10;
	}
	.crumbs a {
		color: inherit;
		opacity: 0.55;
		transition: opacity 180ms ease;
		display: inline-flex;
	}
	.crumbs a:hover { opacity: 1; }
	.crumbs a.active { opacity: 1; }
	.crumbs svg {
		width: 1rem;
		height: 1rem;
	}
	.sep {
		opacity: 0.3;
		font-size: 0.85rem;
	}
</style>
