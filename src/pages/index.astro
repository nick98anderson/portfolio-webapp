---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import VideoWarp from '../components/VideoWarp.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout>
	<VideoWarp
		src={`${base}video/bg.mp4`}
		poster={`${base}video/bg-poster.jpg`}
		portraitSrc={`${base}video/bg-portrait.mp4`}
		portraitPoster={`${base}video/bg-portrait-poster.jpg`}
		controls={import.meta.env.DEV}
	/>
	<Hero />
</Layout>
