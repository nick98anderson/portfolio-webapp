---
import Layout from '../layouts/Layout.astro';
import Crumbs from '../components/Crumbs.astro';
import StillBackdrop from '../components/StillBackdrop.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout>
	<StillBackdrop src={`${base}video/bg-blur.jpg`} />
	<Crumbs active="resume" />
	<main class="resume">
		<header class="resume-header reveal" style="--i: 0">
			<img class="avatar" src={`${base}me.jpeg`} alt="Nick Anderson" width="132" height="132" />
			<h1 class="name">Nick Anderson</h1>
			<p class="contact">
				Calgary, Alberta, Canada&nbsp;&nbsp;•&nbsp;&nbsp;+1 (587) 982-0953&nbsp;&nbsp;•&nbsp;&nbsp;
				<a href="mailto:ncainanderson@gmail.com">ncainanderson@gmail.com</a>
			</p>
			<div class="bio">
				<p>
					I'm a data and software engineer at TELUS. Most of my time has gone into
					building out cloud-native data warehousing and analytics in GCP, and
					developing internal applications and automation tools for finance teams,
					often eliminating or avoiding the need for expensive third-party software.
				</p>
			</div>
		</header>

		<section class="reveal" style="--i: 1">
			<h2 class="section-title">Skills</h2>
			<dl class="skills">
				<dt>Languages</dt>
				<dd><span class="lvl">Proficient:</span> Python, SQL, JavaScript, TypeScript<span class="lvl-sep">;</span> <span class="lvl">Familiar:</span> Go, Java, C++</dd>
				<dt>Technologies</dt>
				<dd><span class="lvl">Proficient:</span> GCP, BigQuery, dbt, Django, Next.js, React<span class="lvl-sep">;</span> <span class="lvl">Familiar:</span> Kubernetes, Airflow</dd>
				<dt>Tools</dt>
				<dd>Git, GitHub Actions, Docker, Kubectl, Pulumi, Postman, gcloud CLI, Claude Code</dd>
				<dt>Non-Technical</dt>
				<dd>Teamwork, listening, leadership, public speaking, creative</dd>
			</dl>
		</section>

		<section class="reveal" style="--i: 2">
			<h2 class="section-title">Relevant Experience</h2>

			<article class="role">
				<div class="role-head">
					<h3>TELUS <span class="sep">·</span> <span class="role-title">Data Engineer</span></h3>
					<span class="meta">Jul 2025 – Present</span>
				</div>
				<ul class="role-summary">
					<li>Rebuilt a billing-to-ERP reconciliation pipeline in dbt across 8 billing systems, correcting faulty logic to eliminate $10M in revenue variances and remove manual reconciliation for finance teams.</li>
					<li>Engineered a master data web platform (Django, Next.js, GKE) to replace three legacy Access/VBA tools, automating data feeds into downstream ERPs while saving $240K/year in licensing.</li>
					<li>Eliminated licence-gated reporting by building extractions into BigQuery, replicating OLAP cube aggregations and deploying custom data apps and dashboards for 300+ self-service users.</li>
					<li>Built agentic harnesses with domain context and direct integrations into internal systems and data warehouses, used by a 5-person team to cut daily tasks and debugging from hours to minutes.</li>
				</ul>
			</article>

			<article class="role">
				<div class="role-head">
					<h3>TELUS <span class="sep">·</span> <span class="role-title">Business Systems Analyst</span></h3>
					<span class="meta">May 2022 – Jul 2025</span>
				</div>
				<ul class="role-summary">
					<li>Re-engineered an on-prem legacy data mart onto GCP (BigQuery, dbt, Python), eliminating proprietary ETL and retiring legacy infrastructure to cut $50K/year in licensing.</li>
					<li>Cut daily and month-end finance work from hours to minutes by replacing manual UI-data management and system configuration with automated REST API integrations and workflows.</li>
					<li>Modernized a traditionally low-code finance systems team by introducing version control and CI/CD, replacing fragile manual processes to cut routine toil and ship faster for internal clients.</li>
				</ul>
			</article>

			<article class="role">
				<div class="role-head">
					<h3>Flare Analytics <span class="sep">·</span> <span class="role-title">Software Developer Intern</span></h3>
					<span class="meta">May 2018 – Sept 2018</span>
				</div>
				<ul class="role-summary">
					<li>Developed client-facing analytics dashboards in React to visualize predictive oil and gas metrics.</li>
					<li>Worked alongside senior engineers on AWS deployment and release processes for client-facing web applications.</li>
				</ul>
			</article>
		</section>

		<section class="reveal" style="--i: 3">
			<h2 class="section-title">Selected Projects</h2>
			<div class="project">
				<div class="project-head">
					<h4>Homebox <span class="sep">·</span> <span class="role-title">Home Automation Server</span></h4>
					<span class="meta">Oct 2026</span>
				</div>
				<ul>
					<li>Built a self-hosted media and home automation stack with Go background services handling TV control, lighting, and playback rules.</li>
					<li>Created a mobile web app and CLI to search, browse the library, and control the TV from anywhere, exposed remotely over Tailscale HTTPS with session auth.</li>
				</ul>
			</div>
		</section>

		<section class="reveal" style="--i: 4">
			<h2 class="section-title">Education</h2>
			<div class="edu">
				<h3>University of Alberta <span class="sep">·</span> <span class="edu-title">BSc, Computing Science</span></h3>
				<span class="meta">Sep 2019 – Dec 2023</span>
			</div>
		</section>
	</main>
</Layout>

<style>
	.resume {
		max-width: 780px;
		margin: 0 auto;
		padding: 5rem 1.75rem 6rem;
		line-height: 1.55;
	}

	.reveal {
		opacity: 0;
		transform: translateY(14px);
		animation: reveal 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
		animation-delay: calc(120ms + var(--i) * 140ms);
	}
	@keyframes reveal {
		to { opacity: 1; transform: translateY(0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.reveal { opacity: 1 !important; transform: none !important; animation: none !important; }
	}

	.resume-header {
		text-align: center;
		margin-bottom: 3rem;
	}
	.name {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.05;
		margin: 0 0 0.75rem;
	}
	.contact {
		margin: 0;
		font-size: 0.95rem;
		opacity: 0.75;
	}
	.avatar {
		width: 132px;
		height: 132px;
		border-radius: 50%;
		object-fit: cover;
		padding: 5px;
		background: var(--accent);
		filter: saturate(0.9) contrast(1.03);
		margin-bottom: 1.5rem;
	}
	.bio {
		margin: 2rem 0 0;
		text-align: left;
		opacity: 0.9;
	}
	.bio p { margin: 0 0 1rem; }
	.bio p:last-child { margin-bottom: 0; }
	.contact a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
	.contact a:hover { color: var(--accent-2); }

	.resume { counter-reset: section; }
	.section-title {
		font-size: 1.05rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0 0 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--line);
	}
	.section-title::before {
		counter-increment: section;
		content: counter(section, decimal-leading-zero) " // ";
		color: var(--accent);
	}

	section {
		margin-bottom: 2.75rem;
	}

	.skills {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.5rem 1.25rem;
		margin: 0;
	}
	.skills dt {
		font-weight: 600;
		opacity: 0.85;
	}
	.skills dd {
		margin: 0;
		opacity: 0.9;
	}

	.role h3, .edu h3 {
		font-size: 1.1rem;
		font-weight: 600;
		margin: 0;
	}
	.role-title, .edu-title { font-weight: 400; opacity: 0.85; }
	.role-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 0.75rem;
	}
	.role + .role { margin-top: 1.75rem; }
	.lvl { font-weight: 600; color: var(--accent); }
	.lvl-sep { margin-right: 0.35rem; }
	.role-summary {
		margin: 0;
		padding-left: 1.15rem;
	}
	.role-summary li {
		margin-bottom: 0.5rem;
		opacity: 0.9;
	}
	.role-summary li::marker { color: var(--accent-2); }
	.subsection {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		opacity: 0.7;
		margin: 0 0 0.5rem;
	}

	.project { margin-top: 0; }
	.project-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 0.5rem;
	}
	.project-head h4 {
		font-size: 1rem;
		font-weight: 600;
		margin: 0;
	}
	.meta {
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		color: var(--accent);
		white-space: nowrap;
	}
	.sep { opacity: 0.5; margin: 0 0.15rem; }

	.project ul {
		margin: 0;
		padding-left: 1.15rem;
	}
	.project li {
		margin-bottom: 0.5rem;
		opacity: 0.9;
	}
	.project li::marker { color: var(--accent-2); }

	/* Print / Save as PDF: plain black-on-white, no effects. */
	@media print {
		@page { margin: 14mm 16mm; }
		:global(html), :global(body) { background: #fff !important; color: #111 !important; }
		.resume { max-width: none; padding: 0; font-size: 10.5pt; line-height: 1.4; }
		.reveal { opacity: 1 !important; transform: none !important; animation: none !important; }
		.avatar { display: none; }
		.resume-header { margin-bottom: 1.25rem; }
		.bio { margin-top: 0.75rem; }
		.name { font-size: 20pt; }
		.contact, .bio, li, dd, dt { opacity: 1 !important; }
		.contact a, .meta, .subsection, .section-title::before { color: #111 !important; }
		.section-title { border-bottom-color: #999; }
		section { margin-bottom: 1.25rem; }
		.project, .role-head, .edu { break-inside: avoid; }
	}

	.edu {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}
</style>
