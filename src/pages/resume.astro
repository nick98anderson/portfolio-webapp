---
import Layout from '../layouts/Layout.astro';
import Crumbs from '../components/Crumbs.astro';
---

<Layout>
	<Crumbs active="resume" />
	<main class="resume">
		<header class="resume-header reveal" style="--i: 0">
			<h1 class="name">Nicholas Anderson</h1>
			<p class="contact">
				Calgary, Alberta, Canada&nbsp;&nbsp;•&nbsp;&nbsp;+1 (587) 982-0953&nbsp;&nbsp;•&nbsp;&nbsp;
				<a href="mailto:nick98anderson@gmail.com">nick98anderson@gmail.com</a>
			</p>
		</header>

		<section class="reveal" style="--i: 1">
			<h2 class="section-title">Skills</h2>
			<dl class="skills">
				<dt>Languages</dt>
				<dd>Python, SQL, JavaScript, Java, C++, Groovy</dd>
				<dt>Tools &amp; Technologies</dt>
				<dd>Pulumi, Terraform, GitHub Actions, Kubernetes, Docker, Google Cloud Platform, React, Django, PostgreSQL, REST, SAP, Oracle EPM</dd>
			</dl>
		</section>

		<section class="reveal" style="--i: 2">
			<h2 class="section-title">Relevant Experience</h2>

			<article class="role">
				<div class="role-head">
					<h3>TELUS <span class="sep">·</span> <span class="role-title">Data Engineer</span></h3>
					<span class="meta">May 2022 – Present</span>
				</div>
				<ul class="role-summary">
					<li>Technical lead across two major platform initiatives; scope covers $5B+/yr in revenue reporting, $100M+/yr in financial planning transactions, 10+ source systems, 300+ users across 7 business units.</li>
					<li>Led full decommission of legacy on-prem stack (MSSQL/Informatica/SAS) and migration to GCP with zero disruption to month-end financial close; cut ~$100K/yr in licensing.</li>
					<li>Partnered with stakeholders across 7 business units to translate financial planning requirements into pipeline designs, data models, and platform features.</li>
					<li>Defined team engineering standards end to end: IaC, CI/CD, branching strategy, release process, design docs; onboarded 3 new developers against those standards.</li>
				</ul>

				<h4 class="subsection">Selected Projects</h4>

				<div class="project">
					<div class="project-head">
						<h4>Financial Planning Platform</h4>
						<span class="meta">Technical Lead <span class="sep">·</span> 2025 – Present</span>
					</div>
					<ul>
						<li>Designed async job pipeline (Celery/Redis) for ERP write-backs with idempotent retry, per-request status tracking, and rollback; kept UI responsive under concurrent approval traffic from 300+ users.</li>
						<li>Built admin interface for live data editing, request queuing, and operational control over import/export operations; LDAP-integrated role-based access controlling approval chains and data visibility.</li>
						<li>Automated end-to-end posting of $100M+/yr in financial planning transactions across 7 business units; cut ~10hr manual cycles to &lt;20min.</li>
					</ul>
				</div>

				<div class="project">
					<div class="project-head">
						<h4>GCP Financial Data Mart Migration</h4>
						<span class="meta">Technical Lead <span class="sep">·</span> 2024 – 2026</span>
					</div>
					<ul>
						<li>Engineered source-of-truth revenue reporting pipeline tracking $5B+/yr at customer-level granularity; 15+ ELT pipelines consolidating 10+ source systems into BigQuery; 30+ downstream BI reports.</li>
						<li>Built event-driven sync pipelines (Cloud Run, Pub/Sub, Cloud Scheduler) automating data flows between enterprise financial systems; eliminated 12+ hrs/month of manual transfers.</li>
						<li>Provisioned all infrastructure as code via Pulumi; designed partitioned/clustered BigQuery tables for interactive-latency query performance; containerized batch pipelines on Cloud Run/Cloud Batch.</li>
					</ul>
				</div>
			</article>
		</section>

		<section class="reveal" style="--i: 3">
			<h2 class="section-title">Education</h2>
			<div class="edu">
				<h3>University of Alberta <span class="sep">·</span> <span class="edu-title">BSc, Computing Science</span></h3>
				<span class="meta">2019 – December 2023</span>
			</div>
		</section>
	</main>
</Layout>

<style>
	.resume {
		max-width: 780px;
		margin: 0 auto;
		padding: 5rem 1.75rem 6rem;
		line-height: 1.55;
	}

	.reveal {
		opacity: 0;
		transform: translateY(14px);
		animation: reveal 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
		animation-delay: calc(120ms + var(--i) * 140ms);
	}
	@keyframes reveal {
		to { opacity: 1; transform: translateY(0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.reveal { opacity: 1 !important; transform: none !important; animation: none !important; }
	}

	.resume-header {
		text-align: center;
		margin-bottom: 3rem;
	}
	.name {
		font-size: clamp(2rem, 4.5vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		margin: 0 0 0.5rem;
	}
	.contact {
		margin: 0;
		font-size: 0.95rem;
		opacity: 0.75;
	}
	.contact a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

	.section-title {
		font-size: 1.05rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		margin: 0 0 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid rgba(232, 226, 208, 0.2);
	}

	section {
		margin-bottom: 2.75rem;
	}

	.skills {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.5rem 1.25rem;
		margin: 0;
	}
	.skills dt {
		font-weight: 600;
		opacity: 0.85;
	}
	.skills dd {
		margin: 0;
		opacity: 0.9;
	}

	.role h3, .edu h3 {
		font-size: 1.1rem;
		font-weight: 600;
		margin: 0;
	}
	.role-title, .edu-title { font-weight: 400; opacity: 0.85; }
	.role-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 0.75rem;
	}
	.role-summary {
		margin: 0 0 1.75rem;
		padding-left: 1.15rem;
	}
	.role-summary li {
		margin-bottom: 0.5rem;
		opacity: 0.9;
	}
	.role-summary li::marker { color: rgba(232, 226, 208, 0.5); }
	.subsection {
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		opacity: 0.7;
		margin: 0 0 0.5rem;
	}

	.project { margin-top: 1.5rem; }
	.project-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 0.5rem;
	}
	.project-head h4 {
		font-size: 1rem;
		font-weight: 600;
		margin: 0;
	}
	.meta {
		font-size: 0.9rem;
		opacity: 0.7;
		white-space: nowrap;
	}
	.sep { opacity: 0.5; margin: 0 0.15rem; }

	.project ul {
		margin: 0;
		padding-left: 1.15rem;
	}
	.project li {
		margin-bottom: 0.5rem;
		opacity: 0.9;
	}
	.project li::marker { color: rgba(232, 226, 208, 0.5); }

	.edu {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}
</style>
